# Public browser-safe configuration (required in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only configuration (required in production; never prefix with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=
RATE_LIMIT_SECRET=

# AI configuration. Use mock locally; production must use a configured provider.
AI_PROVIDER=mock
GEMINI_API_KEY=
# Optional Gemini tuning
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_MS=15000

# Existing optional provider support; not required when Gemini is selected.
OPENAI_API_KEY=

# Optional operations configuration
LOG_LEVEL=info
# Enables authenticated GET /api/health/readiness when set (32+ characters).
READINESS_TOKEN=
